+/*
+ * Bit-banged I2C0 for the TPS65132 bias chip.
+ *
+ * LK's I2C0 controller cannot be used on this board: i2c_hw_init() is an
+ * empty stub and the functional clock is never ungated, so every transfer
+ * ends in I2C_ACKERR and the panel never gets its VSP/VSN rails -- which in
+ * turn leaves DSI commands unanswered and DSI_INTSTA.BUSY stuck at 1.
+ *
+ * The two pads themselves are fine (mainline drives them with i2c-gpio and
+ * sees devices on the bus), so clock them out by hand instead. Open-drain is
+ * emulated the usual way: drive 0 as output-low, release as input so the
+ * board's pull-ups take the line high.
+ */
+#define BB_SDA_PIN	92
+#define BB_SCL_PIN	93
+
+/*
+ * ~20 kHz. The pads have a lot of capacitance through the FPC and the
+ * board pulls are weak, so stay well below the 400 kHz the controller
+ * would use -- mainline's i2c-gpio needs 50 us per half period here too.
+ */
+static void bb_delay(void)
+{
+	UDELAY(25);
+}
+
+static void bb_sda(int level)
+{
+	if (level) {
+		mt_set_gpio_dir(BB_SDA_PIN, GPIO_DIR_IN);	/* release to pull-up */
+	} else {
+		mt_set_gpio_dir(BB_SDA_PIN, GPIO_DIR_OUT);
+		mt_set_gpio_out(BB_SDA_PIN, GPIO_OUT_ZERO);
+	}
+}
+
+static void bb_scl(int level)
+{
+	if (level) {
+		mt_set_gpio_dir(BB_SCL_PIN, GPIO_DIR_IN);
+	} else {
+		mt_set_gpio_dir(BB_SCL_PIN, GPIO_DIR_OUT);
+		mt_set_gpio_out(BB_SCL_PIN, GPIO_OUT_ZERO);
+	}
+}
+
+/*
+ * cust_gpio_boot.h ships these two pads with SMT off, no pull and input
+ * buffer disabled, which is fine for the I2C block (it has its own pads)
+ * but useless for bit-banging: a slow rising edge never crosses the
+ * threshold, so every ack read back looks like a NAK.
+ */
+static void bb_pad_init(void)
+{
+	mt_set_gpio_mode(BB_SDA_PIN, GPIO_MODE_00);
+	mt_set_gpio_mode(BB_SCL_PIN, GPIO_MODE_00);
+
+	mt_set_gpio_smt(BB_SDA_PIN, 1);
+	mt_set_gpio_smt(BB_SCL_PIN, 1);
+	mt_set_gpio_ies(BB_SDA_PIN, 1);
+	mt_set_gpio_ies(BB_SCL_PIN, 1);
+	mt_set_gpio_pull_select(BB_SDA_PIN, GPIO_PULL_UP);
+	mt_set_gpio_pull_select(BB_SCL_PIN, GPIO_PULL_UP);
+
+	mt_set_gpio_dir(BB_SDA_PIN, GPIO_DIR_IN);
+	mt_set_gpio_dir(BB_SCL_PIN, GPIO_DIR_IN);
+}
+
+static void bb_start(void)
+{
+	bb_sda(1); bb_delay();
+	bb_scl(1); bb_delay();
+	bb_sda(0); bb_delay();
+	bb_scl(0); bb_delay();
+}
+
+static void bb_stop(void)
+{
+	bb_sda(0); bb_delay();
+	bb_scl(1); bb_delay();
+	bb_sda(1); bb_delay();
+}
+
+/* returns 0 when the slave acknowledged */
+static int bb_write_byte(unsigned char val)
+{
+	int i, nak;
+
+	for (i = 7; i >= 0; i--) {
+		bb_sda((val >> i) & 1);
+		bb_delay();
+		bb_scl(1); bb_delay();
+		bb_scl(0); bb_delay();
+	}
+
+	/* release SDA and sample it during the ack clock */
+	mt_set_gpio_dir(BB_SDA_PIN, GPIO_DIR_IN);
+	bb_scl(1); bb_delay();
+	nak = mt_get_gpio_in(BB_SDA_PIN);
+	bb_scl(0); bb_delay();
+	mt_set_gpio_dir(BB_SDA_PIN, GPIO_DIR_OUT);
+
+	return nak ? -1 : 0;
+}
+
+static int i2c0_bb_write(unsigned char dev, unsigned char *buf, int len)
+{
+	int i, ret;
+
+	bb_pad_init();
+	bb_sda(1);
+	bb_scl(1);
+	UDELAY(200);
+
+	bb_start();
+	ret = bb_write_byte(dev << 1);
+	for (i = 0; i < len; i++)
+		ret |= bb_write_byte(buf[i]);
+	bb_stop();
+
+	/* hand the pads back to the I2C0 function block */
+	mt_set_gpio_mode(BB_SDA_PIN, GPIO_MODE_01);
+	mt_set_gpio_mode(BB_SCL_PIN, GPIO_MODE_01);
+
+	return ret;
+}
