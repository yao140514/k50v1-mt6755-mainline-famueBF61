+/*
+ * Temporary bring-up aid.
+ *
+ * The logo that ships in dev/logo is hd720 while this panel is 1080x1920,
+ * so the decompressor refuses it ("Logo data error") and the framebuffer is
+ * handed to the display engine still filled with zeros. A black frame tells
+ * us nothing about whether DSI, the bias rails and the panel are actually
+ * alive, so paint colour bars once instead.
+ */
+static int fb_test_pattern_done;
+
+static void mt_disp_draw_test_pattern(void)
+{
+	static const unsigned int bars[8] = {
+		0xffffffff,	/* white   */
+		0xffffff00,	/* yellow  */
+		0xff00ffff,	/* cyan    */
+		0xff00ff00,	/* green   */
+		0xff0000ff,	/* blue    */
+		0xffff0000,	/* red     */
+		0xffff00ff,	/* magenta */
+		0xff000000,	/* black   */
+	};
+	unsigned int stride = ALIGN_TO(CFG_DISPLAY_WIDTH, MTK_FB_ALIGNMENT);
+	unsigned int *p = (unsigned int *)fb_addr;
+	unsigned int x, y;
+
+	for (y = 0; y < CFG_DISPLAY_HEIGHT; y++) {
+		for (x = 0; x < CFG_DISPLAY_WIDTH; x++)
+			p[y * stride + x] = bars[(x * 8) / CFG_DISPLAY_WIDTH];
+	}
+}
