+/*
+ * Hand the bootloader framebuffer over to the kernel.
+ *
+ * LK has already brought up DSI + the panel and keeps scanning out of
+ * g_fb_base. Mainline has no MT6755 display driver (there is no CCU
+ * clock tree for DSI), so the only way to get pixels on this screen is
+ * to let the kernel adopt that very buffer via simple-framebuffer.
+ *
+ * The region was taken with mblock_reserve_ext(), so it is already
+ * absent from the /memory node rewritten further down -- no
+ * /reserved-memory entry is needed.
+ */
+#ifndef MACH_FPGA_NO_DISPLAY
+/*
+ * The framebuffer node now lives in the board DTS
+ * (/chosen/framebuffer@7e3a0000) and is compiled in, so LK must not
+ * touch /chosen here.
+ *
+ * Do not reintroduce the old cell fixup: writing #address-cells /
+ * #size-cells into /chosen applies to its *children*, and the static
+ * node's reg is written for the root's 2/2 layout. With 1/1 forced in,
+ * of_device_alloc() could not translate the address at all and the
+ * kernel logged "simple-framebuffer ...: No memory resource" forever.
+ * Leaving /chosen alone lets of_n_addr_cells() walk up to the root,
+ * where 2/2 is declared.
+ */
+int framebuffer_dts_append(void *fdt)
+{
+	extern unsigned int g_fb_base;
+
+	if (!g_fb_base)
+		return 0;
+
+	dprintf(CRITICAL, "framebuffer: base=0x%x, node comes from the DTS\n",
+		g_fb_base);
+	return 0;
+}
+
+#endif
