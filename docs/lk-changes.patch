@@ -68,6 +69,446 @@ int g_bq25890_hw_exist=0;
 #define BQ25890_I2C_ID  I2C1
 static struct mt_i2c_t bq25890_i2c;
 
+/*
+ * The I2C1 controller is unusable from LK on this board: i2c_hw_init() is an
+ * empty stub, so no transfer ever completes and every charger register read
+ * comes back as the register index itself (bq25890_read_byte() pre-seeds
+ * *returnData with cmd). That leaves the charger unconfigured -- the pack
+ * never actually charges and LK keeps tripping its low-voltage gate.
+ *
+ * Clock the bus out by hand on GPIO91 (SDA) / GPIO94 (SCL) instead. Both pads
+ * default to GPIO_MODE_01 (I2C1 function) with SMT off and no pull, which is
+ * useless for bit-banging, so reconfigure them first -- same lesson learned
+ * from the TPS65132 attempt.
+ */
+#define BQ_SDA_PIN	91
+#define BQ_SCL_PIN	94
+
+/* the LCD-bias pads, scanned for comparison */
+#define BB_SDA_PIN_0	92
+#define BB_SCL_PIN_0	93
+
+static void bq_bb_delay(void)
+{
+	udelay(25);		/* ~20 kHz, the FPC pull-ups are weak */
+}
+
+static void bq_bb_sda(int level)
+{
+	if (level) {
+		mt_set_gpio_dir(BQ_SDA_PIN, GPIO_DIR_IN);
+	} else {
+		mt_set_gpio_dir(BQ_SDA_PIN, GPIO_DIR_OUT);
+		mt_set_gpio_out(BQ_SDA_PIN, GPIO_OUT_ZERO);
+	}
+}
+
+static void bq_bb_scl(int level)
+{
+	if (level) {
+		mt_set_gpio_dir(BQ_SCL_PIN, GPIO_DIR_IN);
+	} else {
+		mt_set_gpio_dir(BQ_SCL_PIN, GPIO_DIR_OUT);
+		mt_set_gpio_out(BQ_SCL_PIN, GPIO_OUT_ZERO);
+	}
+}
+
+static void bq_bb_pad_init(void)
+{
+	mt_set_gpio_mode(BQ_SDA_PIN, GPIO_MODE_00);
+	mt_set_gpio_mode(BQ_SCL_PIN, GPIO_MODE_00);
+	mt_set_gpio_smt(BQ_SDA_PIN, 1);
+	mt_set_gpio_smt(BQ_SCL_PIN, 1);
+	mt_set_gpio_ies(BQ_SDA_PIN, 1);
+	mt_set_gpio_ies(BQ_SCL_PIN, 1);
+	mt_set_gpio_pull_select(BQ_SDA_PIN, GPIO_PULL_UP);
+	mt_set_gpio_pull_select(BQ_SCL_PIN, GPIO_PULL_UP);
+	mt_set_gpio_dir(BQ_SDA_PIN, GPIO_DIR_IN);
+	mt_set_gpio_dir(BQ_SCL_PIN, GPIO_DIR_IN);
+}
+
+/*
+ * Standard bus recovery: a slave interrupted mid-byte keeps SDA low and no
+ * START can ever be generated. Clock SCL nine times with SDA released until
+ * the slave shifts out the remaining bits and lets go.
+ */
+static void bq_bb_bus_recover(void)
+{
+	int i;
+
+	mt_set_gpio_dir(BQ_SDA_PIN, GPIO_DIR_IN);
+	for (i = 0; i < 9; i++) {
+		bq_bb_scl(1); bq_bb_delay();
+		bq_bb_scl(0); bq_bb_delay();
+		if (mt_get_gpio_in(BQ_SDA_PIN))
+			break;
+	}
+}
+
+static void bq_bb_start(void)
+{
+	bq_bb_bus_recover();
+	bq_bb_sda(1); bq_bb_delay();
+	bq_bb_scl(1); bq_bb_delay();
+	bq_bb_sda(0); bq_bb_delay();
+	bq_bb_scl(0); bq_bb_delay();
+}
+
+static void bq_bb_stop(void)
+{
+	bq_bb_sda(0); bq_bb_delay();
+	bq_bb_scl(1); bq_bb_delay();
+	bq_bb_sda(1); bq_bb_delay();
+}
+
+/* 0 on ACK */
+static int bq_bb_write_byte(unsigned char val)
+{
+	int i, nak;
+
+	for (i = 7; i >= 0; i--) {
+		bq_bb_sda((val >> i) & 1);
+		bq_bb_delay();
+		bq_bb_scl(1); bq_bb_delay();
+		bq_bb_scl(0); bq_bb_delay();
+	}
+
+	mt_set_gpio_dir(BQ_SDA_PIN, GPIO_DIR_IN);
+	bq_bb_scl(1); bq_bb_delay();
+	nak = mt_get_gpio_in(BQ_SDA_PIN);
+	bq_bb_scl(0); bq_bb_delay();
+	mt_set_gpio_dir(BQ_SDA_PIN, GPIO_DIR_OUT);
+
+	return nak ? -1 : 0;
+}
+
+static int bq_bb_read_byte(unsigned char *out)
+{
+	int i;
+	unsigned char v = 0;
+
+	mt_set_gpio_dir(BQ_SDA_PIN, GPIO_DIR_IN);
+	for (i = 7; i >= 0; i--) {
+		bq_bb_scl(1); bq_bb_delay();
+		v = (v << 1) | (mt_get_gpio_in(BQ_SDA_PIN) ? 1 : 0);
+		bq_bb_scl(0); bq_bb_delay();
+	}
+	/*
+	 * NACK the final byte. Driving SDA low here would tell the slave to
+	 * send yet another byte: it keeps the line driven through our STOP and
+	 * the very next transfer NAKs. That is exactly what the register dump
+	 * showed -- register 0 read back fine, register 1 failed.
+	 */
+	mt_set_gpio_dir(BQ_SDA_PIN, GPIO_DIR_IN);
+	bq_bb_delay();
+	bq_bb_scl(1); bq_bb_delay();
+	bq_bb_scl(0); bq_bb_delay();
+
+	*out = v;
+	return 0;
+}
+
+/* returns I2C_OK / -1 in the driver's convention */
+static int bq_bb_write_reg(unsigned char reg, unsigned char val)
+{
+	int ret;
+
+	bq_bb_pad_init();
+	bq_bb_sda(1); bq_bb_scl(1);
+	udelay(200);
+
+	bq_bb_start();
+	ret = bq_bb_write_byte((BQ25890_SLAVE_ADDR_WRITE >> 1) << 1);
+	ret |= bq_bb_write_byte(reg);
+	ret |= bq_bb_write_byte(val);
+	bq_bb_stop();
+
+	return ret ? -1 : I2C_OK;
+}
+
+static int bq_bb_read_reg(unsigned char reg, unsigned char *val)
+{
+	int ret;
+
+	bq_bb_pad_init();
+	bq_bb_sda(1); bq_bb_scl(1);
+	udelay(200);
+
+	bq_bb_start();
+	ret = bq_bb_write_byte((BQ25890_SLAVE_ADDR_WRITE >> 1) << 1);
+	ret |= bq_bb_write_byte(reg);
+	if (ret) {
+		bq_bb_stop();
+		return -1;
+	}
+
+	bq_bb_start();		/* repeated start */
+	ret = bq_bb_write_byte((BQ25890_SLAVE_ADDR_READ >> 1) << 1);
+	if (ret) {
+		bq_bb_stop();
+		return -1;
+	}
+	bq_bb_read_byte(val);
+	bq_bb_stop();
+
+	return I2C_OK;
+}
+
+/*
+ * One-shot bus survey.
+ *
+ * Every transfer on both bit-banged buses fails, and the failure looks the
+ * same whether the pads are wrong or the chip simply is not there. Enumerate
+ * what answers instead of guessing: mainline already found 0x38/0x3b on the
+ * i2c0 pads and 0x62 on the i2c1 pads, so if LK's scan comes back empty the
+ * pads/timing are at fault; if it finds those same addresses, the bit-bang is
+ * fine and 0x3E / 0x6B are simply unpopulated on this board.
+ */
+static void bb_pads(int sda, int scl)
+{
+	mt_set_gpio_mode(sda, GPIO_MODE_00);
+	mt_set_gpio_mode(scl, GPIO_MODE_00);
+	mt_set_gpio_smt(sda, 1);
+	mt_set_gpio_smt(scl, 1);
+	mt_set_gpio_ies(sda, 1);
+	mt_set_gpio_ies(scl, 1);
+	mt_set_gpio_pull_select(sda, GPIO_PULL_UP);
+	mt_set_gpio_pull_select(scl, GPIO_PULL_UP);
+	mt_set_gpio_dir(sda, GPIO_DIR_IN);
+	mt_set_gpio_dir(scl, GPIO_DIR_IN);
+}
+
+static void bb_low(int pin)
+{
+	mt_set_gpio_dir(pin, GPIO_DIR_OUT);
+	mt_set_gpio_out(pin, GPIO_OUT_ZERO);
+}
+
+/* 1 when the address was acknowledged */
+static int bb_probe(int sda, int scl, unsigned char addr8)
+{
+	int i, ack;
+
+	bb_pads(sda, scl);
+
+	/* start: SDA falls while SCL is high */
+	mt_set_gpio_dir(sda, GPIO_DIR_IN); udelay(25);
+	mt_set_gpio_dir(scl, GPIO_DIR_IN); udelay(25);
+	bb_low(sda); udelay(25);
+	bb_low(scl); udelay(25);
+
+	for (i = 7; i >= 0; i--) {
+		if ((addr8 >> i) & 1)
+			mt_set_gpio_dir(sda, GPIO_DIR_IN);
+		else
+			bb_low(sda);
+		udelay(25);
+		mt_set_gpio_dir(scl, GPIO_DIR_IN); udelay(25);
+		bb_low(scl); udelay(25);
+	}
+
+	mt_set_gpio_dir(sda, GPIO_DIR_IN); udelay(25);
+	mt_set_gpio_dir(scl, GPIO_DIR_IN); udelay(25);
+	ack = mt_get_gpio_in(sda) ? 0 : 1;
+	bb_low(scl); udelay(25);
+
+	/* stop */
+	bb_low(sda); udelay(25);
+	mt_set_gpio_dir(scl, GPIO_DIR_IN); udelay(25);
+	mt_set_gpio_dir(sda, GPIO_DIR_IN); udelay(25);
+
+	return ack;
+}
+
+static void bb_scan_bus(int sda, int scl, const char *tag)
+{
+	char found[128];
+	int addr, n = 0, idle_sda, idle_scl, len;
+	int lo_sda, hi_sda, lo_scl, hi_scl;
+
+	bb_pads(sda, scl);
+	udelay(200);
+	idle_sda = mt_get_gpio_in(sda) ? 1 : 0;
+	idle_scl = mt_get_gpio_in(scl) ? 1 : 0;
+
+	/*
+	 * Is the pad actually ours to drive? Drive 0, read back, release, read
+	 * back. A working pad gives 0 then 1. If driving 0 still reads 1 the
+	 * pin is not muxed to GPIO (or its IO rail is dead) and no amount of
+	 * timing tuning will make the bus work.
+	 */
+	bb_low(sda); udelay(50);
+	lo_sda = mt_get_gpio_in(sda) ? 1 : 0;
+	mt_set_gpio_dir(sda, GPIO_DIR_IN); udelay(50);
+	hi_sda = mt_get_gpio_in(sda) ? 1 : 0;
+
+	bb_low(scl); udelay(50);
+	lo_scl = mt_get_gpio_in(scl) ? 1 : 0;
+	mt_set_gpio_dir(scl, GPIO_DIR_IN); udelay(50);
+	hi_scl = mt_get_gpio_in(scl) ? 1 : 0;
+
+	dprintf(CRITICAL,
+		"i2c-scan %s: pad test sda %d/%d scl %d/%d, idle sda=%d scl=%d\n",
+		tag, lo_sda, hi_sda, lo_scl, hi_scl, idle_sda, idle_scl);
+
+	len = 0;
+	found[0] = 0;
+	for (addr = 0x08; addr < 0x78 && len < (int)sizeof(found) - 6; addr++) {
+		/* bb_probe() returns 1 when the address was acknowledged */
+		if (bb_probe(sda, scl, (unsigned char)(addr << 1))) {
+			len += snprintf(found + len, sizeof(found) - len,
+					" %02x", addr);
+			n++;
+		}
+	}
+
+	dprintf(CRITICAL, "i2c-scan %s: %d dev%s:%s\n",
+		tag, n, n == 1 ? "" : "s", n ? found : " (none)");
+}
+
+/* read one register from an arbitrary 8-bit slave address */
+static int bq_bb_read_reg_at(unsigned char addr8, unsigned char reg,
+			     unsigned char *val)
+{
+	int ret;
+
+	bq_bb_pad_init();
+	bq_bb_sda(1); bq_bb_scl(1);
+	udelay(200);
+
+	bq_bb_start();
+	ret = bq_bb_write_byte(addr8);
+	ret |= bq_bb_write_byte(reg);
+	if (ret) {
+		bq_bb_stop();
+		return -1;
+	}
+
+	/*
+	 * STOP then START rather than a repeated START. The part at 0x62
+	 * acknowledged its address, returned 0x00 for register 0 and then
+	 * failed on register 1 -- the classic signature of a slave that does
+	 * not implement a repeated START. A full STOP in between is the
+	 * portable form and costs two bit times.
+	 */
+	bq_bb_stop();
+	udelay(50);
+	bq_bb_start();
+	ret = bq_bb_write_byte(addr8 | 1);
+	if (ret) {
+		bq_bb_stop();
+		return -1;
+	}
+	bq_bb_read_byte(val);
+	bq_bb_stop();
+
+	return 0;
+}
+
+/*
+ * Read-only fingerprint of whatever answers on the charger bus. Nothing is
+ * written: the driver's register map is a bq25890 one and the chip at 0x62
+ * may well be a different part, so identify it before poking at it.
+ */
+static void bb_dump_chip(unsigned char addr7, const char *tag)
+{
+	unsigned char v;
+	int i;
+
+	if (bq_bb_read_reg_at((unsigned char)(addr7 << 1), 0, &v)) {
+		dprintf(CRITICAL, "i2c-dump %s 0x%02x: no ack\n", tag, addr7);
+		return;
+	}
+
+	dprintf(CRITICAL, "i2c-dump %s 0x%02x:", tag, addr7);
+	dprintf(CRITICAL, " %02x=%02x", 0, v);
+	for (i = 1; i < 16; i++) {
+		if (bq_bb_read_reg_at((unsigned char)(addr7 << 1), i, &v)) {
+			dprintf(CRITICAL, " (fail at 0x%02x)\n", i);
+			return;
+		}
+		dprintf(CRITICAL, " %02x=%02x", i, v);
+	}
+	dprintf(CRITICAL, "\n");
+}
+
+/* write one register at an arbitrary 8-bit slave address */
+static int bq_bb_write_reg_at(unsigned char addr8, unsigned char reg,
+			      unsigned char val)
+{
+	int ret;
+
+	bq_bb_pad_init();
+	bq_bb_sda(1); bq_bb_scl(1);
+	udelay(200);
+
+	bq_bb_start();
+	ret = bq_bb_write_byte(addr8);
+	ret |= bq_bb_write_byte(reg);
+	ret |= bq_bb_write_byte(val);
+	bq_bb_stop();
+
+	return ret ? -1 : 0;
+}
+
+/*
+ * Charger bring-up on the part that actually answers.
+ *
+ * The driver above talks to 0x6B and NAKs on every access, while the bus scan
+ * finds a single device at 0x62 whose register map is bq2589x (see the register
+ * dump in the log). Its REG00 reads 0x00, i.e. IINLIM = 100 mA -- the adapter
+ * is only allowed to deliver half a watt, which is far less than the phone
+ * burns, so the pack discharges even while plugged in.
+ *
+ * Two conservative writes, both read back:
+ *   REG00 = 0x20  -> EN_HIZ=0, IINLIM code 4 = 1000 mA input limit
+ *   REG05 = 0x10  -> ICHG  code 16 = 1024 mA charge current
+ * VREG (REG04) already reads 0x50 = 4.18 V and is left untouched.
+ */
+static void bq_bb_charge_setup(unsigned char addr7)
+{
+	unsigned char a8 = (unsigned char)(addr7 << 1);
+	unsigned char v = 0;
+
+	bq_bb_write_reg_at(a8, 0x00, 0x20);
+	bq_bb_write_reg_at(a8, 0x05, 0x10);
+
+	if (bq_bb_read_reg_at(a8, 0x00, &v) == 0)
+		dprintf(CRITICAL, "i2c-chg: REG00 now 0x%02x (IINLIM code %u)\n",
+			v, (v >> 3) & 0x0F);
+	else
+		dprintf(CRITICAL, "i2c-chg: REG00 readback failed\n");
+
+	if (bq_bb_read_reg_at(a8, 0x05, &v) == 0)
+		dprintf(CRITICAL, "i2c-chg: REG05 now 0x%02x (ICHG code %u)\n",
+			v, v & 0x7F);
+	else
+		dprintf(CRITICAL, "i2c-chg: REG05 readback failed\n");
+
+	if (bq_bb_read_reg_at(a8, 0x0B, &v) == 0)
+		dprintf(CRITICAL, "i2c-chg: status REG0B = 0x%02x\n", v);
+	if (bq_bb_read_reg_at(a8, 0x0A, &v) == 0)
+		dprintf(CRITICAL, "i2c-chg: status REG0A = 0x%02x\n", v);
+}
+
+static void bb_scan_all(void)
+{
+	bb_scan_bus(BB_SDA_PIN_0, BB_SCL_PIN_0, "i2c0(gpio92/93)");
+	bb_scan_bus(BQ_SDA_PIN, BQ_SCL_PIN, "i2c1(gpio91/94)");
+
+	/*
+	 * The scan keeps finding a single responder at 0x62 while the driver
+	 * talks to 0x6B, which is why charging has never worked: every access
+	 * NAKs and the pack just discharges. Identify the part before
+	 * deciding how to drive it.
+	 */
+	bb_dump_chip(0x62, "i2c1");
+
+	/* the only responder on this bus is the charger; give it a usable
+	 * input current limit instead of the 100 mA default */
+	bq_bb_charge_setup(0x62);
+}
